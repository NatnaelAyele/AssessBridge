DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=assessbridge
DB_USER=root
DB_PASSWORD=
JWT_SECRET=replace-with-a-random-secret
COOKIE_SECURE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
EXAM_ENTRY_URL=http://127.0.0.1:8000/exam-entry
SEB_REQUIRED=true
SEB_BASE_URL=http://127.0.0.1:8000
SEB_CONFIG_KEY=
SEB_CONFIG_PASSWORD=
SEB_QUIT_PASSWORD=
RECORDINGS_DIR=var/recordings
RECORDING_KEY=replace-with-a-random-base64-encoded-32-byte-key
RECORDING_RETENTION_DAYS=30
IDENTITY_RETENTION_DAYS=30
# Defaults for new assessment policies. Company administrators can set periods in Company settings.
TESSERACT_CMD=

# Local AI monitoring worker (never changes exam outcomes).
MONITORING_AUTO_START=true
MONITORING_CONCURRENCY=2
# Leave blank to use PATH or var/ffmpeg/ffmpeg.exe on Windows.
FFMPEG_CMD=

# Server-wide authentication/staff-access audit retention; blank keeps new logs indefinitely.
# Changes apply only to newly recorded events. Existing expiry dates are preserved.
SECURITY_AUDIT_RETENTION_DAYS=

# Fictional identities only. backend/setup_esignet.py prepares these settings.
# Keep disabled on a real examination installation.
ESIGNET_DEMO_ENABLED=false
ESIGNET_ISSUER=http://127.0.0.1:3000
ESIGNET_CLIENT_ID=assessbridge-demo
ESIGNET_REDIRECT_URI=http://127.0.0.1:8000/identity/esignet/callback
ESIGNET_PRIVATE_KEY_FILE=var/esignet/client-private.pem
